{
  "name": "daetum",
  "version": "1.0.0",
  "description": "DAETUM - engineering drawing and statics tool for written solutions (geometry, statics, dimensions, analysis, sheets).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "test": "node --test tests/*.test.cjs",
    "lint": "eslint src server",
    "test:golden": "node tests/e2e/golden-scenario.mjs",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.2.1",
    "node-tikzjax": "^1.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "eslint": "^10.12.0",
    "eslint-scope": "^9.1.2",
    "globals": "^17.13.0",
    "jsdom": "^23.2.0",
    "vite": "^8.3.2"
  }
}
